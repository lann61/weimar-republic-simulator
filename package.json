{
  "name": "weimar-republic-simulator",
  "private": true,
  "version": "2.2.1",
  "description": "Weimar Republic - The Fall of Democracy. Political civilization evolution simulator.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node e2e/smoke.mjs",
    "validate:data": "tsx scripts/validate-data/run.ts",
    "audit:branches": "node --import tsx scripts/audit-branches.mjs",
    "test:flows": "node --import tsx e2e/flows.mjs"
  },
  "dependencies": {
    "dexie": "^4.0.11",
    "echarts": "^6.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright": "^1.64.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^6.0.3",
    "vitest": "^2.1.8"
  }
}
